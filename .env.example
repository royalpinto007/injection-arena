# injection-arena configuration. Copy to .env.local to customize.
# The app runs fully offline with the deterministic mock agent by default,
# so none of these are required to play.

# ---- Agent provider selection ----
# One of: mock (default) | openai | anthropic | groq
# If the selected provider's key is missing, the app falls back to `mock`.
AGENT_PROVIDER=mock

# Provider API keys (only needed if AGENT_PROVIDER is set to that provider)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# ---- Session signing ----
# Change this in production. Signs the per-player identity cookie.
SESSION_SECRET=dev-insecure-secret-change-me

# ---- Persistence ----
# SQLite database path. Defaults to ./data/arena.db
DATABASE_PATH=data/arena.db

# ---- Rate limiting (attempt endpoint) ----
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
